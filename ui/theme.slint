export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #101216 : #eef0f4;
    out property <color> sidebar: dark ? #0c0e11 : #e3e6ec;
    out property <color> surface: dark ? #171a20 : #ffffff;
    out property <color> surface2: dark ? #1f232b : #f4f5f8;
    out property <color> surface3: dark ? #272c36 : #e9ebf0;
    out property <color> border: dark ? #2a303b : #d5d9e0;
    out property <color> hover: dark ? #ffffff14 : #00000010;
    out property <color> selection: dark ? #2f5fb040 : #2563eb28;
    out property <color> text: dark ? #e7eaf0 : #1b1f27;
    out property <color> text-dim: dark ? #9099a8 : #5d6675;
    out property <color> text-faint: dark ? #667082 : #8a93a1;
    out property <color> accent: dark ? #4d8dff : #2563eb;
    out property <color> accent-soft: dark ? #4d8dff26 : #2563eb1a;
    out property <color> success: dark ? #3fb97a : #1a8f55;
    out property <color> warning: dark ? #e0a93a : #b7791f;
    out property <color> danger: dark ? #f0605d : #d13438;
    out property <color> danger-soft: dark ? #f0605d26 : #d134381a;
    out property <color> folder: dark ? #e8b84a : #c9921a;
    out property <color> scrim: #000000a0;
}
